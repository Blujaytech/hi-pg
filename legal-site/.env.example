# Copy this file to .env for a local/direct deployment. The .env file is ignored.
LEGAL_OPERATOR_NAME=Your verified legal or business name
LEGAL_SUPPORT_EMAIL=support@example.com
LEGAL_POSTAL_ADDRESS=Your complete public postal address
LEGAL_GRIEVANCE_NAME=Name of the grievance contact
LEGAL_GRIEVANCE_EMAIL=grievance@example.com
LEGAL_GOVERNING_JURISDICTION=India
PUBLIC_SITE_URL=https://legal.example.com

# Store the signed APK in Cloudflare R2 because Cloudflare Pages limits a
# single static asset to 25 MiB. Use the R2 custom-domain URL in production.
APP_DOWNLOAD_URL=https://downloads.example.com/releases/hi-pg-android.apk
APP_VERSION=0.1.1
APP_APK_SIZE=60 MB
APP_APK_SHA256=replace-with-the-64-character-sha256-checksum
APP_MIN_ANDROID=Android 7.0+
