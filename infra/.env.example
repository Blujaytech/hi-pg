# Local dev (infra/docker-compose.yml): copy to .env and fill in before running
# `docker compose --profile full up`. For production (infra/docker-compose.prod.yml), see the
# separate checklist in docs/deployment.md -- the same variable names are reused there but every
# one of them is required (no dev fallback), plus POSTGRES_PASSWORD.
JWT_SECRET=change-me-to-a-long-random-string
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Only used by docker-compose.prod.yml -- generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Provisioned later (Phase 12/13) -- see docs/decisions.md ADR-0019/ADR-0020. Leave blank in dev;
# every endpoint that needs these returns 501 until they're set to real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
