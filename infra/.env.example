# Local dev (infra/docker-compose.yml): copy to .env and fill in before running
# `docker compose --profile full up`. For production (infra/docker-compose.prod.yml), see the
# separate checklist in docs/deployment.md -- the same variable names are reused there but every
# one of them is required (no dev fallback), plus POSTGRES_PASSWORD.
JWT_SECRET=change-me-to-a-long-random-string
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Only used by docker-compose.prod.yml -- generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Razorpay Checkout + Route + Subscriptions. Use test-mode keys locally and
# configure the webhook URL as /api/v1/webhooks/razorpay. Blank keys keep the
# integration disabled and payment endpoints return 501.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com
# Web application client ID. Used as the ID-token audience by Flutter and the
# backend. Native Google sign-in does not require a client secret.
GOOGLE_OAUTH_CLIENT_ID=
# Private KYC/student document storage. Set S3_ENABLED=true after creating a
# non-public S3-compatible bucket. Signed URLs are used for time-limited reads.
S3_ENABLED=false
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE_ACCESS=false
