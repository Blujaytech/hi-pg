# Android upload-key configuration. Copy to android/key.properties and fill in.
#
# key.properties, *.jks and *.keystore are git-ignored: this file is the only
# one that belongs in the repo. Losing the keystore means you can never ship an
# update to an existing Play listing, so back it up somewhere durable.
#
# Create the key (once):
#   keytool -genkey -v -keystore upload-keystore.jks -storetype JKS \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Then read off the SHA-1/SHA-256 you must register for Google Sign-In and for
# the Google Maps API key restriction (package com.hipg.app):
#   keytool -list -v -keystore upload-keystore.jks -alias upload
#
# CI can set ANDROID_KEYSTORE_FILE / ANDROID_KEYSTORE_PASSWORD /
# ANDROID_KEY_ALIAS / ANDROID_KEY_PASSWORD instead of writing this file.

# Path to the keystore, relative to mobile/android/ (or absolute).
storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
