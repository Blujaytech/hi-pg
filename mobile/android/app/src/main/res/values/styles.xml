<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 7-11 launch window: the brand mark on black, identical to the
         first frame of the Flutter launch animation (lib/auth/splash_screen.dart)
         so the hand-off is seamless. Android 12+ uses values-v31 instead. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window colour behind the Flutter UI once it is running. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
