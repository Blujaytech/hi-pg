<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night mode outranks the API-level qualifier during resource lookup,
         so without this copy a dark-mode Android 12+ device would fall back
         to values-night and lose the branded system splash. Keep identical
         to values-v31/styles.xml. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/brand_ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowBackground">@color/brand_ink</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
