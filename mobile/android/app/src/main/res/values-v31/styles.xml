<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash. splash_mark is drawn at the same size and
         position the Flutter launch animation starts from
         (HiPgMarkPainter.adaptiveMarkFraction of a 288dp canvas). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/brand_ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowBackground">@color/brand_ink</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
